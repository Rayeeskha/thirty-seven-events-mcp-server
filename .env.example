NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thirty_seven_events
DB_USER=t37
# Keep the single quotes: in a .env file an unquoted "#" starts a comment and silently
# truncates the value. (If the password itself contains a single quote, use backticks.)
DB_PASSWORD='change_me'
DB_LOGGING=false

CONFIRMATION_TTL_SECONDS=300

MCP_PATH=/mcp
MCP_HOST=127.0.0.1
MCP_PORT=3001
# Comma-separated Host header values accepted by /mcp. Empty = localhost only.
# Set to your public hostname when exposing the server remotely (e.g. via a tunnel).
MCP_ALLOWED_HOSTS=

# =============================================================================
# DEMO / TESTING KEYWORDS  (comments only: nothing below changes how the app runs)
#
# Type these into Claude with the thirty-seven-events connector switched on.
# There are no special keywords: ask in plain English and Claude picks the tool.
#
#   search_events            "Which events do we have for Najd Telecom?"
#                            "Show me all cancelled events."
#                            "What events are happening on 4 December 2026?"
#                            "List events between 1 November and 31 December 2026."
#   get_event_details       "Give me full details of event 8."
#   add_event (asks first)  "Create an event called Saudi Tech Expo on 10 May 2027 for
#                            Kingdom Fintech Council, budget 310,500.50 SAR."   then "Yes" or "No"
#   update_event_status     "Mark event 10 as in progress."   then "Yes"
#   draft_marketing_message "Write an Instagram post for event 10 in English and Arabic."
#                            "Write a marketing email in Arabic for event 10."
#
# Reset the sample data afterwards:   npm run db:reset
# Full prompt list and troubleshooting: docs/CONNECTING_CLAUDE.md
#
# MCP SETTINGS BY MODE (each setting goes on its OWN line as NAME=value;
# never paste a whole command into this file)
#
#   MODE 1: Claude Desktop / Claude Code on your own Mac (default, safest)
#     MCP_PATH=/mcp
#     MCP_ALLOWED_HOSTS=
#
#   MODE 2: cloud connector through a tunnel (temporary demo only, no login!)
#     MCP_ALLOWED_HOSTS=your-tunnel-hostname.trycloudflare.com   (hostname only)
#     MCP_PATH=/mcp/some-random-secret
#   Restart the server after changing this file.
# =============================================================================
