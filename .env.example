NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thirty_seven_events
DB_USER=t37
# Keep the single quotes: in a .env file an unquoted "#" starts a comment and silently
# truncates the value. (If the password itself contains a single quote, use backticks.)
DB_PASSWORD='change_me'
DB_LOGGING=false
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=60000

CONFIRMATION_TTL_SECONDS=300

MCP_PATH=/mcp
MCP_HOST=127.0.0.1
MCP_PORT=3001
# Comma-separated Host header values accepted by /mcp. Empty = localhost only.
# Set to your public hostname when exposing the server remotely (e.g. via a tunnel).
MCP_ALLOWED_HOSTS=

